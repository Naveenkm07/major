{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Crop",
    "type": "object",
    "required": [
        "name",
        "category",
        "season"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "localName": {
            "type": "string"
        },
        "category": {
            "type": "string",
            "enum": [
                "cereal",
                "pulse",
                "oilseed",
                "vegetable",
                "fruit",
                "spice",
                "fiber",
                "other"
            ]
        },
        "season": {
            "type": "string",
            "enum": [
                "kharif",
                "rabi",
                "zaid",
                "perennial"
            ]
        },
        "description": {
            "type": "string"
        },
        "growthDuration": {
            "type": "integer"
        },
        "optimalConditions": {
            "type": "object",
            "properties": {
                "temperature": {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number"
                        },
                        "max": {
                            "type": "number"
                        }
                    }
                },
                "rainfall": {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number"
                        },
                        "max": {
                            "type": "number"
                        }
                    }
                },
                "soilType": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "soilPh": {
                    "type": "object",
                    "properties": {
                        "min": {
                            "type": "number"
                        },
                        "max": {
                            "type": "number"
                        }
                    }
                }
            }
        },
        "calendar": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "stage",
                    "startWeek",
                    "endWeek"
                ],
                "properties": {
                    "stage": {
                        "type": "string"
                    },
                    "startWeek": {
                        "type": "integer"
                    },
                    "endWeek": {
                        "type": "integer"
                    },
                    "activities": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "tips": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "imageUrl": {
            "type": "string"
        }
    }
}