{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "User",
    "type": "object",
    "required": [
        "name",
        "email",
        "phone",
        "password"
    ],
    "properties": {
        "name": {
            "type": "string",
            "maxLength": 100
        },
        "email": {
            "type": "string",
            "format": "email"
        },
        "phone": {
            "type": "string",
            "pattern": "^[6-9]\\d{9}$"
        },
        "password": {
            "type": "string",
            "minLength": 6
        },
        "role": {
            "type": "string",
            "enum": [
                "farmer",
                "expert",
                "admin"
            ],
            "default": "farmer"
        },
        "avatar": {
            "type": "string"
        },
        "location": {
            "type": "object",
            "properties": {
                "state": {
                    "type": "string"
                },
                "district": {
                    "type": "string"
                },
                "village": {
                    "type": "string"
                },
                "coordinates": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "Point"
                            ]
                        },
                        "coordinates": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        }
                    }
                }
            }
        },
        "farmDetails": {
            "type": "object",
            "properties": {
                "landArea": {
                    "type": "number"
                },
                "soilType": {
                    "type": "string"
                },
                "irrigationType": {
                    "type": "string",
                    "enum": [
                        "rainfed",
                        "irrigated",
                        "mixed"
                    ]
                },
                "crops": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "fcmToken": {
            "type": "string"
        },
        "isVerified": {
            "type": "boolean",
            "default": false
        },
        "isActive": {
            "type": "boolean",
            "default": true
        }
    }
}