# ─── Server ───────────────────────────────────────────
APP_NAME=KrushikaDhara AI Service
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ─── JWT (MUST match Node.js backend JWT_SECRET) ─────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256

# ─── ML Models ────────────────────────────────────────
DISEASE_MODEL_PATH=app/ml_models/crop_disease_model.h5
DISEASE_LABELS_PATH=app/ml_models/disease_labels.json

# ─── AWS S3 (for image uploads) ──────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=krushikadhara-uploads

# ─── OpenAI (for chatbot — leave blank for rule-based fallback) ─
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# ─── External APIs ───────────────────────────────────
WEATHER_API_KEY=your_openweathermap_api_key
WEATHER_API_URL=https://api.openweathermap.org/data/2.5
